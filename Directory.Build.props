<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <!-- No warnings are suppressed by default. IL2026/IL3050 (AOT/trimming) are never suppressed per section 3 rule 4. -->
    <!-- CA1724: SessionState is a mandated type name (Brief §6); System.Web.SessionState does not exist in .NET 10. -->
    <!-- CA1822: ISettingsStore.LoadAsync/SaveAsync are interface members and must be instance methods. -->
    <!-- CA1034/CA1708: C# 14 extension blocks are nested types by design. -->
    <!-- CA1055: MaskCredentialText returns display string, not a URI. -->
    <NoWarn>CA1724;CA1822;CA1034;CA1708;CA1055;CA1515</NoWarn>
    <RepositoryUrl>https://github.com/migueljocode/AriaSharp</RepositoryUrl>
    <Copyright>Copyright (c) AriaSharp contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <!-- Project-wide global usings (all projects inherit). -->
  <ItemGroup>
    <Using Include="System.Globalization" />
    <Using Include="System.Text" />
    <Using Include="System.Text.Json" />
    <Using Include="AriaSharp.Models" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
